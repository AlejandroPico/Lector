{
  "name": "lector-zen",
  "version": "2.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/notices.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "desktop": "electron .",
    "icons": "node scripts/icons.mjs",
    "native:sync": "npm run icons && node scripts/native-version.mjs && cap sync",
    "desktop:pack": "electron-builder --publish never"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@tesseract.js-data/cat": "^1.0.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@tesseract.js-data/hin": "^1.0.0",
    "@tesseract.js-data/ita": "^1.0.0",
    "@tesseract.js-data/jpn": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "dompurify": "^3.3.0",
    "foliate-js": "1.0.1",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.58.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "jsdom": "^27.0.0",
    "sharp": "0.35.5",
    "vite": "^7.3.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "argparse": "^2.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true
  },
  "main": "desktop/main.cjs",
  "description": "Lector de libros y lectura en voz alta",
  "author": {
    "name": "Alejandro Pico",
    "url": "https://github.com/AlejandroPico"
  },
  "homepage": "https://alejandropico.github.io/Lector/",
  "license": "UNLICENSED"
}
